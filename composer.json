{
    "name": "danog/php-rtc-webrtc",
    "type": "library",
  "description": "A modular PHP WebRTC stack for PHP 8.2+, ported to Amp v3 with pure-PHP DTLS/SRTP and optional media FFI. Maintained by danog for MadelineProto.",
    "keywords": [
        "rtp",
        "webrtc"
    ],
    "homepage": "https://github.com/danog/php-rtc-webrtc",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3.1.3",
        "danog/php-rtc-exception": "^1.1.5",
        "danog/php-rtc-ice": "^1.1.18 || ^2.0",
        "danog/php-rtc-rtp": "^1.1.13 || ^2.0",
        "danog/php-rtc-sctp": "^2.0.11",
        "danog/php-rtc-stats": "^1.1.3",
        "danog/php-rtc-sdp": "^1.1.6",
        "danog/php-rtc-dtls": "^1.1.9 || ^2.0",
        "danog/php-rtc-ntp": "^1.1.6",
        "danog/php-rtc-mixin": "^2.0",
        "symfony/polyfill-php84": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.3.2",
        "bamarni/composer-bin-plugin": "^1.9.1"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\Webrtc\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\Webrtc\\": "tests"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
